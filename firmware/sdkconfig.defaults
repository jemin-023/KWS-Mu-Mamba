# ESP32-C3 Mu-Mamba KWS Configuration Defaults
CONFIG_IDF_TARGET="esp32c3"

# CPU Frequency: 160 MHz maximum performance
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# Main Task Stack Size: 16 KB (default 3.5 KB is too small for audio inference buffers)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Compiler optimization for performance
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS Tick Rate 1000 Hz for precise 1 ms audio timing
CONFIG_FREERTOS_HZ=1000

# Enable High-Resolution Timer (esp_timer)
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
